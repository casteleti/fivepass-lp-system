# Variáveis para deploy na VPS via Coolify
# Copie estas variáveis no painel do Coolify > Environment Variables
#
# ⚠️  NEXT_PUBLIC_* são gravadas no bundle durante o BUILD — marque "Available at Buildtime" no Coolify
#     e faça redeploy após alterar qualquer uma delas.

# --- Runtime apenas ---
DATABASE_URL=mysql://root:root@db:3306/fivepass
REDIS_URL=redis://redis:6379
NODE_ENV=production

# --- Build + Runtime (marcar "Available at Buildtime" no Coolify) ---
NEXT_PUBLIC_SITE_URL=https://fivepass.daksa.ia.br
NEXT_PUBLIC_WHATSAPP_PHONE=5516992980598
NEXT_PUBLIC_WHATSAPP_MESSAGE=Olá! Quero saber como a Fivepass dá mais margem no meu evento.

# --- Depreciadas (substituídas pelas NEXT_PUBLIC_* acima) ---
# WHATSAPP_PHONE_NUMBER=5511999999999
# WHATSAPP_DEFAULT_MESSAGE=Olá! Gostaria de saber mais sobre Fivepass...
